{
  "name": "@delali/uhttp",
  "version": "0.0.0",
  "description": "An HTTP and WebSocket server for Node.js on uWebSockets.js.",
  "author": "Delali (https://sondelali.com)",
  "license": "MIT",
  "homepage": "https://github.com/assetcorp/uhttp",
  "repository": {
    "type": "git",
    "url": "https://github.com/assetcorp/uhttp.git",
    "directory": "packages/ts"
  },
  "bugs": {
    "url": "https://github.com/assetcorp/uhttp/issues"
  },
  "keywords": [
    "http",
    "server",
    "websocket",
    "uwebsockets",
    "framework",
    "router",
    "middleware",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./access-log": {
      "types": "./dist/middleware/access-log/index.d.ts",
      "import": "./dist/middleware/access-log/index.js"
    },
    "./compression": {
      "types": "./dist/middleware/compression/index.d.ts",
      "import": "./dist/middleware/compression/index.js"
    },
    "./cookies": {
      "types": "./dist/middleware/cookies/index.d.ts",
      "import": "./dist/middleware/cookies/index.js"
    },
    "./cors": {
      "types": "./dist/middleware/cors/index.d.ts",
      "import": "./dist/middleware/cors/index.js"
    },
    "./csrf": {
      "types": "./dist/middleware/csrf/index.d.ts",
      "import": "./dist/middleware/csrf/index.js"
    },
    "./rate-limit": {
      "types": "./dist/middleware/rate-limit/index.d.ts",
      "import": "./dist/middleware/rate-limit/index.js"
    },
    "./request-id": {
      "types": "./dist/middleware/request-id/index.d.ts",
      "import": "./dist/middleware/request-id/index.js"
    },
    "./secure-headers": {
      "types": "./dist/middleware/secure-headers/index.d.ts",
      "import": "./dist/middleware/secure-headers/index.js"
    },
    "./static": {
      "types": "./dist/middleware/static/index.d.ts",
      "import": "./dist/middleware/static/index.js"
    },
    "./trusted-proxies": {
      "types": "./dist/middleware/trusted-proxies/index.d.ts",
      "import": "./dist/middleware/trusted-proxies/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15 <23 || >=24 <25 || >=26 <27"
  },
  "scripts": {
    "compile": "rm -rf dist && tsc -p tsconfig.build.json",
    "build": "pnpm run compile && pnpm run api",
    "api": "node scripts/api-report.ts",
    "api:write": "pnpm run compile && node scripts/api-report.ts --write",
    "test": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:package": "vitest run --project package",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "speed": "pnpm run compile && node benchmarks/speed-guard/local.ts"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.4",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "arktype": "2.2.7",
    "rollup": "4.64.6",
    "typescript": "7.0.2",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#9ec36de7709996c58dce03d63796216c90a17136",
    "valibot": "1.5.0",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "uWebSockets.js": ">=20.70.0 <21"
  }
}
