{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "uhttp",
  "sourceRoot": "packages/ts/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "packages/ts"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "command": "pnpm run test:coverage",
        "cwd": "packages/ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "packages/ts"
      }
    },
    "api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run api",
        "cwd": "packages/ts"
      }
    },
    "api:write": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run api:write",
        "cwd": "packages/ts"
      }
    }
  }
}
